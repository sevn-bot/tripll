<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}{% if title != 'tripll' %} — tripll{% endif %}</title>
  <link rel="stylesheet" href="assets/site.css" />
  {% block extra_head %}{% endblock %}
</head>
<body>
  <div class="shell">
    <nav class="nav" aria-label="Help pages">
      <strong class="nav-brand">tripll</strong>
      {% for href, label in nav_pages %}
      <a href="{{ href }}"{% if slug ~ '.html' == href %} class="active"{% endif %}>{{ label }}</a>
      {% endfor %}
    </nav>
    <main class="main">
      <h1>{{ title }}</h1>
      {% if summary %}<p class="summary">{{ summary }}</p>{% endif %}
      {% block content %}{% endblock %}
      <footer class="footer">
        Generated by <code>make about-site</code> — edit
        <code>about-tripll/_sources/{{ slug }}.yaml</code> or templates, not the HTML directly.
      </footer>
    </main>
  </div>
</body>
</html>
